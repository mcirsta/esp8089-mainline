--- /dev/null
+++ b/ba-window.c
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: Apache-2.0
+/* The v19 aggregate builder and BAR calculation share peer byte 0x75.
+ * Keep their existing eight-frame ceiling, but never exceed any TX BA
+ * window accepted during this peer lifetime. The minimum is intentionally
+ * sticky across TID stops: raising it could violate another active TID.
+ * SETSTA initializes it to eight for a new HT peer. No new state or ABI.
+ */
+typedef unsigned int u32;
+extern void original_ba_state(unsigned char *peer, u32 action, u32 tid);
+
+void ba_window_start(unsigned char *peer, u32 action, u32 tid, u32 window)
+{
+ if (!peer || tid >= 8 || !window || window > 64)
+  return;
+ if (!peer[0x75] || peer[0x75] > 8)
+  return;
+ if (window < peer[0x75])
+  peer[0x75] = window;
+ original_ba_state(peer, action, tid);
+}
--- /dev/null
+++ b/ba-window.S
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+.section .text.ba_window_entry,"ax",@progbits
+.global ba_window_entry
+.type ba_window_entry,@function
+ba_window_entry:
+.begin no-transform
+ /* At the original TX_OPERATIONAL call, a12 points to the SIP payload.
+  * Keep peer/action/TID in a2/a3/a4, add negotiated window in a5.
+  * A tail jump preserves the dispatcher's original return address.
+  */
+ l8ui a5, a12, 3
+ j ba_window_start
+.end no-transform
+.size ba_window_entry,.-ba_window_entry
--- /dev/null
+++ b/ba-window-host-test.c
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "ba-window.c"
+
+static unsigned calls, observed_tid, observed_limit;
+void original_ba_state(unsigned char *peer, u32 action, u32 tid)
+{
+ assert(action == 2);
+ observed_tid = tid;
+ observed_limit = peer[0x75];
+ calls++;
+}
+
+int main(void)
+{
+ unsigned char peer[0x78], expected[sizeof(peer)];
+ unsigned tests = 0;
+
+ for (unsigned old = 1; old <= 8; old++) {
+  for (unsigned window = 1; window <= 64; window++) {
+   for (unsigned tid = 0; tid < 8; tid++) {
+    memset(peer, 0xa5, sizeof(peer));
+    peer[0x75] = old;
+    memcpy(expected, peer, sizeof(peer));
+    expected[0x75] = old < window ? old : window;
+    calls = 0;
+    ba_window_start(peer, 2, tid, window);
+    assert(calls == 1 && observed_tid == tid);
+    assert(observed_limit == expected[0x75]);
+    assert(!memcmp(peer, expected, sizeof(peer)));
+    tests++;
+   }
+  }
+ }
+ /* Other TIDs and later sessions cannot reopen a smaller active window. */
+ peer[0x75] = 8;
+ ba_window_start(peer, 2, 0, 4);
+ ba_window_start(peer, 2, 3, 2);
+ ba_window_start(peer, 2, 0, 64);
+ assert(peer[0x75] == 2);
+ for (unsigned window = 0; window <= 255; window++) {
+  if (window && window <= 64)
+   continue;
+  peer[0x75] = 8;
+  calls = 0;
+  ba_window_start(peer, 2, 0, window);
+  assert(!calls && peer[0x75] == 8);
+ }
+ calls = 0;
+ ba_window_start(NULL, 2, 0, 1);
+ ba_window_start(peer, 2, 8, 1);
+ peer[0x75] = 0;
+ ba_window_start(peer, 2, 0, 1);
+ peer[0x75] = 9;
+ ba_window_start(peer, 2, 0, 1);
+ assert(!calls);
+ printf("PASS: %u valid peer/window/TID combinations; neighboring fields, minimum-before-enable, sticky multi-TID bound and invalid inputs\n", tests);
+}
